{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "proxy": {
    "entrypoint": "admin-auth.js",
    "matcher": "/admin/:path*"
  },
  "rewrites": [
    {
      "source": "/admin/settings",
      "destination": "/api/settings"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
